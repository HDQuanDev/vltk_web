{
  "name": "kiem-hiep-web",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p packages/game-core/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "vitest run tests/integration/content.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "report:content": "node scripts/audit-content.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "healthcheck": "node scripts/healthcheck.mjs",
    "profile:world": "node scripts/profile-world.mjs",
    "profile:core": "node scripts/profile-navigation.mjs",
    "profile:footprint": "node scripts/profile-footprint.mjs"
  },
  "dependencies": {
    "@kiem-hiep/game-content": "workspace:*",
    "@kiem-hiep/game-core": "workspace:*",
    "@kiem-hiep/game-protocol": "workspace:*",
    "@kiem-hiep/game-session": "workspace:*",
    "@kiem-hiep/game-storage": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.35.0",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
